{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // Icons are Nerd Font glyphs (kitty uses JetBrainsMono Nerd Font). Colours: Catppuccin Mocha.
  "logo": { "color": { "1": "38;2;137;180;250", "2": "38;2;203;166;247" }, "padding": { "right": 2 } },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;203;166;247", "title": "38;2;137;180;250", "separator": "38;2;108;112;134" }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": " OS" },
    { "type": "kernel", "key": " Kernel" },
    { "type": "uptime", "key": " Uptime" },
    { "type": "packages", "key": " Packages" },
    { "type": "shell", "key": " Shell" },
    { "type": "de", "key": " DE" },
    { "type": "wm", "key": " WM" },
    { "type": "terminal", "key": " Terminal" },
    { "type": "cpu", "key": " CPU" },
    { "type": "gpu", "key": " GPU" },
    { "type": "memory", "key": " Memory" },
    { "type": "disk", "key": " Disk" },
    "break",
    "colors"
  ]
}

#!/usr/bin/env bash
# nusku-fetch: the terminal greeting. Runs fastfetch; with krabby installed (the optional
# "Pokémon in fastfetch" app) a random Gen 1-3 Pokémon replaces the Arch logo. Never prints
# an error: krabby missing, failing or silent just means the Arch logo.

command -v fastfetch >/dev/null 2>&1 || exit 0

sprite=""
if command -v krabby >/dev/null 2>&1; then
    sprite="$(krabby random 1-3 2>/dev/null)" || sprite=""
fi

if [ -n "$sprite" ]; then
    fastfetch --data-raw "$sprite" 2>/dev/null || true
else
    fastfetch 2>/dev/null || true
fi
exit 0

# Nusku: rendered by the installer so the accent applies. Flavor: config/yazi/flavors.
[flavor]
dark = "catppuccin-mocha"

[mgr]
cwd = { fg = "#{{accent}}" }

[tabs]
active   = { fg = "#{{base}}", bg = "#{{accent}}", bold = true }
inactive = { fg = "#{{accent}}", bg = "#{{surface0}}" }

[mode]
normal_main = { fg = "#{{base}}", bg = "#{{accent}}", bold = true }
normal_alt  = { fg = "#{{accent}}", bg = "#{{surface0}}" }

[tasks]
border  = { fg = "#{{accent}}" }
hovered = { fg = "#{{accent}}", bold = true }
